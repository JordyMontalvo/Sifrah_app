input[type="checkbox"]:checked
  accent-color #e91e63

.register-title-form
  text-align center
  margin 25px 0 30px 0

  h1
    font-size 32px
    font-weight 900
    color #111111
    background linear-gradient(90deg, #111111 33%, #111111 25%, #e91e63 70%)
    -webkit-background-clip text
    background-clip text
    -webkit-text-fill-color transparent
    margin 0
    font-family 'Open Sans', sans-serif

  @media (max-width: 768px)
    display none

.form-field
  position relative
  width 100%
  max-width 509px
  margin 0 auto 15px
  box-sizing border-box

.form-row
  display flex
  gap 12px
  align-items stretch
  width 100%
  max-width 509px
  margin-left auto
  margin-right auto
  box-sizing border-box

  .form-field
    flex 1 1 0
    min-width 0
    width auto
    max-width none
    margin-left 0
    margin-right 0
    margin-bottom 15px

  .input-container
    width 100%
    max-width none
    min-width 0
    margin 0

  .input-register-new
    width 100%
    max-width 100%
    min-width 0
    box-sizing border-box

.input-register-new
  width 100%
  max-width 100%
  padding 10px 16px
  height 45px
  border 2px solid #e91e63
  border-radius 10px
  font-size 14px
  font-family 'Open Sans', sans-serif
  background white
  color #333
  transition all 0.3s ease

  &:focus
    outline none
    border-color #e91e63
    box-shadow 0 0 0 3px rgba(210, 9, 182, 0.1)

  &::placeholder
    color #999

  &.error
    border-color #e74c3c

.select-field
  appearance none
  background-image url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23e91e63' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6,9 12,15 18,9'%3e%3c/polyline%3e%3c/svg%3e")
  background-repeat no-repeat
  background-position right 18px center
  background-size 25px
  padding-right 50px

.checkbox-field
  width 100%
  max-width 509px
  margin 0 auto 15px
  display flex
  justify-content flex-start
  box-sizing border-box

.terms-field
  width 100%
  max-width 509px
  margin-left auto
  margin-right auto
  display flex
  justify-content center
  box-sizing border-box

  .checkbox-label
    align-items flex-start
    max-width 100%

  .checkbox-text
    text-align left
    flex 1
    min-width 0

.checkbox-label
  display flex
  align-items center
  gap 8px
  margin 0
  padding 0
  line-height 1.2
  cursor pointer

.checkbox-input
  width 16px
  height 16px
  margin 0
  border 2px solid #e91e63
  border-radius 0
  background white
  cursor pointer
  flex-shrink 0

.checkbox-text
  color #666
  font-size 14px
  font-family 'Open Sans', sans-serif

.legal-link
  color #e91e63
  font-weight inherit
  text-decoration none

  &:hover
    text-decoration underline

.register-button
  width 100%
  max-width 509px
  height 50px
  padding 15px
  background #e91e63
  color white
  border none
  border-radius 29px
  font-size 16px
  font-weight bold
  font-family 'Open Sans', sans-serif
  cursor pointer
  transition all 0.3s ease
  margin 8px auto 20px
  display block

  &:hover
    background #e91e63

  &:disabled
    background #000
    opacity 0.7
    cursor not-allowed

.input-container
  position relative
  display block
  width 100%
  max-width 509px
  margin 0 auto
  padding 0
  box-sizing border-box
  min-width 0
  overflow hidden

.input-icon
.overflow-icon
  position absolute
  top 50%
  right 18px
  width 25px
  height 25px
  margin 0
  padding 0
  transform translateY(-50%)
  display flex
  align-items center
  justify-content center
  color #e91e6382
  font-size 20px
  line-height 1
  z-index 10
  pointer-events none
  box-sizing border-box

.password-icon
.calendar-icon
  pointer-events auto
  cursor pointer
  transition color 0.3s ease

  &:hover
    color #e91e63

.date-input
  display block
  min-width 0
  max-width 100%
  width 100%
  appearance none
  -webkit-appearance none

  &::-webkit-calendar-picker-indicator
    display none
    -webkit-appearance none

  &::-webkit-inner-spin-button
    display none
    -webkit-appearance none

  &::-webkit-datetime-edit
  &::-webkit-datetime-edit-fields-wrapper
  &::-webkit-datetime-edit-text
  &::-webkit-datetime-edit-month-field
  &::-webkit-datetime-edit-day-field
  &::-webkit-datetime-edit-year-field
  &::-webkit-date-and-time-value
    min-width 0
    padding 0

.input-container .input-register-new
  padding-right 50px
  box-sizing border-box
  width 100%

.alert-message
  background-color #fee
  color #c00
  padding 12px 16px
  border-radius 8px
  border 1px solid #fcc
  margin 12px auto
  font-size 14px
  text-align center
  max-width 280px
  width 100%

@media (max-width: 899px)
  .input-container
  .form-row
  .form-field
  .checkbox-field
  .terms-field
  .register-button
    width 100%
    max-width 100%
    margin-left auto
    margin-right auto
    box-sizing border-box
    min-width 0

  .form-field
    overflow hidden

  .date-input
    min-width 0
    max-width 100%
    width 100%

  .form-row
    display flex
    flex-wrap nowrap
    gap 8px

    .form-field
      flex 1 1 0
      min-width 0
      max-width none
      width auto
      margin-bottom 10px

    .input-container
      width 100%
      max-width 100%
      overflow hidden

    .input-register-new
      min-width 0
      max-width 100%
      padding-left 10px

  .input-icon
  .overflow-icon
    right 12px
    width 22px
    height 22px
    font-size 18px

  .input-container .input-register-new
    padding-right 44px

  .select-field
    min-width 0
    background-size 22px
    background-position right 12px center
    padding-right 44px

  .form-field
    margin-bottom 10px

  .checkbox-field
    margin-top 0
    margin-bottom 10px

  .input-register-new
    font-size 15px
    padding 8px 10px
    height 42px

  .register-button
    width 90%
    max-width 400px
    height 42px
    padding 10px
    margin-bottom 12px
    border-radius 25px
    font-size 15px

@media (max-width: 480px)
  .form-field
    margin-bottom 8px

  .checkbox-field
    margin-top 0
    margin-bottom 8px

  .form-row
    gap 8px

    .form-field
      margin-bottom 8px

  .input-register-new
    padding 8px 10px
    font-size 14px
    height 42px

  .register-button
    width 95%
    max-width 350px
    height 38px
    font-size 14px
    padding 8px
    margin-bottom 10px
    border-radius 20px

@media (max-width: 375px)
  .form-field
    margin-bottom 6px

  .form-row
    gap 6px

    .form-field
      margin-bottom 6px

  .input-register-new
    padding 7px 9px
    font-size 13px
    height 40px

  .register-button
    width 95%
    max-width 320px
    height 35px
    font-size 13px
    padding 6px
    margin-bottom 8px
    border-radius 18px

.register-success
  max-width 520px
  margin 0 auto
  padding 24px 16px 32px
  text-align center

.success-icon-wrap
  display flex
  justify-content center
  margin-bottom 16px

.success-icon-circle
  width 72px
  height 72px
  border-radius 50%
  background linear-gradient(135deg, #43a047 0%, #2e7d32 100%)
  display flex
  align-items center
  justify-content center
  box-shadow 0 8px 24px rgba(46, 125, 50, 0.25)

  i
    color #fff
    font-size 2rem

.success-title
  margin 0 0 8px
  font-size 1.75rem
  font-weight 700
  color #2e7d32

.success-subtitle
  margin 0 0 24px
  color #555
  font-size 1rem

.success-user-card
  background linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%)
  border 1px solid #c8e6c9
  border-radius 16px
  padding 20px 16px
  margin-bottom 20px

.success-user-avatar
  width 48px
  height 48px
  margin 0 auto 12px
  border-radius 50%
  background #fff
  border 2px solid #a5d6a7
  display flex
  align-items center
  justify-content center

  i
    color #43a047
    font-size 1.25rem

.success-user-label
  margin 0 0 6px
  color #333
  font-size 0.95rem

.success-user-dni
  margin 0 0 4px
  font-size 1.75rem
  font-weight 700
  color #2e7d32
  letter-spacing 0.5px

.success-user-hint
  margin 0
  color #666
  font-size 0.85rem

.success-info-box
  display flex
  align-items flex-start
  gap 10px
  text-align left
  background #e3f2fd
  border 1px solid #90caf9
  border-radius 12px
  padding 14px 16px
  margin-bottom 24px
  color #1565c0
  font-size 0.92rem
  line-height 1.4

  i
    flex-shrink 0
    margin-top 2px
    font-size 1.1rem

.success-home-btn
  display inline-flex
  align-items center
  justify-content center
  gap 10px
  width 100%
  max-width 460px
  margin 0 auto 16px

.success-session-note
  margin 0 0 24px
  color #666
  font-size 0.88rem
  line-height 1.45
  max-width 420px
  margin-left auto
  margin-right auto

.success-help
  margin-bottom 20px
  padding-top 16px
  border-top 1px solid #eee

  p
    margin 0
    color #777
    font-size 0.9rem
    line-height 1.4

@media (max-width: 768px)
  .register-success
    padding 16px 12px 24px

  .success-title
    font-size 1.5rem

  .success-user-dni
    font-size 1.5rem

  .success-home-btn
    width 90%
    max-width 400px
