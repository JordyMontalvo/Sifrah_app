.auth
  position relative
  display flex
  height 100vh
  max-height 100vh
  overflow hidden
  padding 0
  background #fff
  align-items stretch

  .auth-visual
    position absolute
    top 0
    right 0
    width 50%
    height 100%
    background url('assets/img/logo/Group 1.svg') no-repeat center center / cover
    z-index 1
    pointer-events none

  .auth-tabs--desk
    position absolute
    top 0
    left calc(50% + 200px)
    display flex
    z-index 4

  .auth-tabs--mobile
    display none

  .auth-tab
    width 170px
    height 70px
    display flex
    align-items center
    justify-content center
    text-decoration none
    font-weight 700
    font-size 15px
    font-family 'Open Sans', sans-serif
    background #fff
    color #111
    border 1px solid #e5e5e5
    box-sizing border-box

    &.active
    &.router-link-exact-active
      background #111
      color #fff
      border-color #111

  .auth-welcome
    position absolute
    top 0
    right 0
    width 50%
    height 100%
    display flex
    align-items flex-start
    padding-top 25%
    padding-left 5%
    z-index 3
    pointer-events none
    color #fff

  .auth-mobile-copy
    display none

  .welcome-content
    text-align left
    font-family 'Open Sans', sans-serif

  .welcome-subtitle
    font-size clamp(20px, 2.4vw, 32px)
    font-weight 600
    margin 0 0 5px
    letter-spacing 0.06em
    color rgba(255, 255, 255, 0.9)

  .welcome-title
    font-size clamp(42px, 7.5vw, 120px)
    font-weight 900
    margin 0 0 10px
    letter-spacing 5px
    line-height 0.9
    text-shadow 0 0 30px rgba(255, 255, 255, 0.4)

  .welcome-slogan
    font-size clamp(14px, 2vw, 32px)
    font-weight 600
    margin 0
    letter-spacing 0.06em
    color rgba(255, 255, 255, 0.9)

  .auth-panel
    position relative
    z-index 2
    width 50%
    height 100vh
    display flex
    justify-content center
    align-items center
    background #fff

    .content
      width 100%

    .form
      width 100%
      height 100vh
      padding 24px 8%
      background #fff
      display flex
      flex-direction column
      justify-content center
      overflow-y auto
      box-sizing border-box

  .input-container
    width 100%
    max-width 509px
    margin-left auto
    margin-right auto
    box-sizing border-box

  .login-link
    text-align center
    margin-top 8px

    @media (max-width: 768px)
      margin-bottom 12px

    @media (max-width: 480px)
      margin-bottom 10px

    @media (max-width: 375px)
      margin-bottom 8px

    small
      color #666
      font-size 14px

      @media (max-width: 768px)
        font-size 13px

      @media (max-width: 480px)
        font-size 12px

      @media (max-width: 375px)
        font-size 11px

      a
        color #e91e63
        text-decoration none

        &:hover
          text-decoration underline

  .social
    display flex
    justify-content center
    gap 14px

    a
      padding 0

  .social-icon
    width 68px
    height 68px
    border-radius 50%
    display inline-flex
    align-items center
    justify-content center
    text-decoration none
    background #fff
    box-shadow 0 10px 22px rgba(0,0,0,0.14)
    transition transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease
    font-size 30px
    line-height 1

    &:hover
      transform translateY(-2px)
      box-shadow 0 14px 28px rgba(0,0,0,0.18)

    &.facebook
      color #1877F2

    &.youtube
      color #FF0000

    &.tiktok
      color #111111

    &.whatsapp
      color #25D366

    @media (max-width: 768px)
      width 58px
      height 58px
      font-size 26px

    @media (max-width: 480px)
      width 52px
      height 52px
      font-size 24px

    @media (max-width: 375px)
      width 48px
      height 48px
      font-size 22px

@media (max-width: 900px)
  .auth
    flex-direction column
    --auth-header 76%
    --auth-tabs-overlap 80px

    &.register-page
      --auth-header 40%
      --auth-tabs-overlap 72px

    .auth-visual
      position relative
      top auto
      right auto
      left 0
      width 100%
      height 0
      padding-top var(--auth-header)
      flex-shrink 0
      overflow hidden
      background-image url('assets/img/logo/iphone-inicio-cell.png')
      background-position top center
      background-size 100% auto
      background-repeat no-repeat

    &.register-page .auth-visual
      background-image url('assets/img/logo/iphone-registro-cell.png')

    .auth-tabs--desk
    .auth-welcome
      display none

    .auth-mobile-copy
      display block
      position absolute
      top 5vw
      left 0
      right 0
      z-index 3
      text-align center
      pointer-events none
      color #fff

      .auth-mobile-headline
        display flex
        flex-direction column
        align-items center

      .auth-mobile-logo
        display block
        width 60px
        height auto
        margin 0 auto 10px
        filter drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4))

      h1
        font-size clamp(18px, 5.4vw, 24px)
        font-weight 700
        margin 0 0 4px
        line-height 1.1
        letter-spacing 1px
        text-shadow 0 2px 4px rgba(0, 0, 0, 0.45)

      p
        font-size clamp(12px, 3.6vw, 16px)
        font-weight 600
        margin 0
        text-shadow 0 2px 4px rgba(0, 0, 0, 0.45)

    &.register-page .auth-mobile-copy
      top 3.5vw

      .auth-mobile-headline
        display grid
        grid-template-columns 1fr auto 1fr
        align-items center
        column-gap 6px
        margin-bottom 4px
        transform translateX(18px)

      .auth-mobile-logo
        width 28px
        margin 0
        grid-column 1
        justify-self end

      h1
        grid-column 2
        margin 0

    .auth-tabs--mobile
      display flex
      justify-content center
      position relative
      top auto
      left auto
      right auto
      flex-shrink 0
      z-index 5
      margin calc(var(--auth-tabs-overlap) * -1) 0 0
      padding 28px 18px 12px
      background #fff
      box-sizing border-box
      border-top-left-radius 40px
      border-top-right-radius 40px
      overflow hidden

      .auth-tab
        width auto
        height auto
        padding 8px 22px
        background transparent
        border none
        border-bottom 2px solid #89888d
        color #89888d
        font-size 15px
        font-weight 600

        &.active
        &.router-link-exact-active
          color #e91e63
          border-bottom 4px solid #e91e63
          background transparent
          font-weight 800

    .auth-panel
      position relative
      top auto
      left auto
      right auto
      bottom auto
      flex 1
      min-height 0
      width 100%
      height auto
      background #fff
      align-items stretch

      .form
        height 100%
        justify-content flex-start
        padding 8px 18px 18px
        background transparent
        overflow-y auto

.auth.office-embed
  background #fdfafc

  .auth-visual
  .auth-tabs
  .auth-welcome
  .auth-mobile-copy
    display none

  .auth-panel
    position relative
    top auto
    left auto
    right auto
    bottom auto
    width 100%
    height auto

  .form
    padding 24px
