  padding: 10px;
  color: black;
  margin-bottom 30px

.flex-activacion
  display flex
  gap 20px


@media(max-width: d-break)
  .flex-activacion
    display block



/* Estilos para el botón de prueba */
.btn-red
  background #f44336
  color white
  
  &:hover
    background #d32f2f

// V-cloak para evitar que se muestre contenido sin datos
[v-cloak]
  display none !important
/* --- Mobile Tabs Menu Styles --- */
.mobile-tabs-overlay
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  width 100%
  height 100%
  background #000000
  z-index 10000
  display flex
  align-items stretch
  justify-content flex-start
  backdrop-filter none

.mobile-tabs-menu
  width 100%
  height 100%
  background #000000
  box-shadow none
  display flex
  flex-direction column
  animation none
  overflow hidden

.mobile-tabs-header
  padding 20px 16px 16px
  display flex
  justify-content flex-start
  align-items flex-start
  border-bottom none
  background #000000
  position relative

.mobile-menu-user-info
  display flex
  flex-direction row
  align-items center
  gap 12px
  text-decoration none
  padding-right 40px

.mobile-photo-label
  cursor pointer
  width 52px
  height 52px

.mobile-photo-container
  position relative
  width 52px
  height 52px
  border-radius 50%
  overflow hidden
  border 2px solid #e91e63
  flex-shrink 0

.mobile-menu-photo
  width 100%
  height 100%
  object-fit cover
  display block

.mobile-photo-overlay
  display none !important

.mobile-menu-name
  font-weight 700
  font-size 17px
  margin 0
  color #ffffff

.mobile-menu-email
  display none

.mobile-menu-rank
  display flex
  align-items center
  gap 6px
  margin 6px 0 0
  color #ffffff
  font-size 13px
  font-weight 500

.mobile-menu-rank-label
  color #ffffff
  font-weight 500

.mobile-menu-rank em
  font-style normal
  color #e91e63
  font-weight 600

.mobile-tabs-content
  padding 0
  gap 0

.mobile-menu-item
  min-height 56px
  height 56px
  padding 0 18px 0 20px
  border-radius 0
  border-bottom 1px solid rgba(255, 255, 255, 0.1)
  font-weight 500
  font-size 16px
  letter-spacing 0.01em

.mobile-menu-item:hover
  background transparent
  color #ffffff

.mobile-menu-item.active,
.mobile-menu-item.router-link-active
  background linear-gradient(90deg, #6b1a38 0%, #3a121c 48%, #1a0c12 100%)
  border-radius 0 10px 10px 0
  border-bottom-color transparent
  margin-right 10px

@keyframes slideInRight
  from
    transform translateX(100%)
  to
    transform translateX(0)

/* --- Sidebar Photo Edit Styles --- */
.text-header label
  position relative
  cursor pointer
  display inline-block

.text-header .controls
  display flex
  gap 10px
  justify-content center
  margin-top 8px
  
  i
    cursor pointer
    font-size 18px
    padding 6px
    border-radius 50%
    background rgba(255, 255, 255, 0.1)
    color white
    transition all 0.2s
    
    &:hover
      background rgba(255, 255, 255, 0.2)
    
    &.photo-control-confirm
      color #4CAF50
    &.photo-control-cancel
      color #f44336

