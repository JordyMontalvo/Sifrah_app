.welcome-title-form
  text-align center
  margin 25px 0 60px 0

  h1
    font-size 32px
    font-weight 900
    color #111111
    background linear-gradient(90deg, #111111 33%, #111111 25%, #e91e63 70%)
    -webkit-background-clip text
    background-clip text
    -webkit-text-fill-color transparent
    margin 0
    font-family 'Open Sans', sans-serif

.login-button
  border-radius 29px
  width 100%
  max-width 509px
  height 50px
  background #e91e63
  color white
  border none
  cursor pointer
  margin 10px auto 8px
  display block
  transition background 0.3s ease

  &:hover
    background #cf1658

  &:disabled
    background #000
    opacity 0.7
    cursor not-allowed

.label-login-2
.label-login
  font-size 12px
  color rgba(137, 136, 141, 1)
  display block
  text-align left
  width 100%
  max-width 509px
  margin-left auto
  margin-right auto

.label-login-2
  margin-top 10px
  margin-bottom 4px

.label-login
  margin-bottom 4px

.input
  border 2px solid #e91e63
  padding-right 44px
  width 100%
  max-width 509px
  box-sizing border-box

.input-wrapper
  position relative
  display block
  width 100%
  max-width 509px
  margin 0 auto 16px
  line-height 0

  .input
    display block
    margin 0
    line-height normal

.forgot-password
  display block
  color rgba(137, 136, 141, 1)
  margin 24px auto 20px
  text-align center
  width 100%
  max-width 509px

  a
    color #e91e63
    text-decoration none

    &:hover
      text-decoration underline

.dni-icon
.show
  position absolute
  right 18px
  width 25px
  height 25px
  top 50%
  transform translateY(-50%)
  margin 0
  padding 0
  display block

.dni-icon
  pointer-events none

.show
  cursor pointer

@media (max-width: 900px)
  .welcome-title-form
    display none

@media (max-width: 899px)
  .input-wrapper
  .label-login
  .label-login-2
  .login-button
    width 78%
    max-width 300px

  .input
    width 100%
    max-width 100%
    margin-left 0
    margin-right 0
    box-sizing border-box

  .input-wrapper
    .dni-icon
    .show
      top 50%
      right 12px
      width 22px
      height 22px
      margin 0
      padding 0
      transform translateY(-50%)
